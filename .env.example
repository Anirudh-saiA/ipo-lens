# Copy to .env and adjust. Never commit .env.
POSTGRES_USER=ipolens
POSTGRES_PASSWORD=ipolens_dev
POSTGRES_DB=ipolens
# Host port for Postgres. 54329 avoids clashing with local Postgres installs on 5432-5434.
POSTGRES_PORT=54329

# Used by the backend (FastAPI, Alembic, tests)
DATABASE_URL=postgresql+psycopg://ipolens:ipolens_dev@localhost:54329/ipolens

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
